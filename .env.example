# SQL Server (Windows authentication)
DB_SERVER=localhost
DB_NAME=NEWSPULSE

# Comma-separated list of RSS feed URLs
RSS_URLS=https://www.thehindu.com/feeder/default.rss

# Ollama model used to categorize articles
OLLAMA_MODEL=gemma4:e4b

# Must match the rows in the Categories table
CATEGORIES=World,India,Technology,Business,Science,Sports,Health,Other
WANTED_CATEGORIES=World,India,Technology

# How many entries to take from each feed
MAX_ENTRIES_PER_FEED=5

# Speed settings for summaries: trim article text (characters), cap the reply (tokens)
TRIM_TEXT=true
TRIM_SIZE=4000
CAP_TEXT=false
CAP_SIZE=300
